#!/bin/busybox sh

# Native Debian early userspace for the Lenovo P90 (P90a40, Moorefield).
# This is PID 1. It intentionally does not invoke Android init or Android tools.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
BB=/bin/busybox
ROOT=/data/local/p90-debian

$BB mkdir -p /proc /sys /dev /data
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t tmpfs -o mode=0755,nosuid tmpfs /dev

say() {
    echo "p90-init: $*" >/dev/console 2>/dev/null || echo "p90-init: $*"
}

node() {
    path=$1
    type=$2
    major=$3
    minor=$4
    mode=$5
    [ -e "$path" ] || $BB mknod -m "$mode" "$path" "$type" "$major" "$minor"
}

# CONFIG_DEVTMPFS is disabled in Lenovo's kernel. These nodes therefore must
# exist before a conventional Debian userspace can start.
$BB mkdir -p /dev/block /dev/graphics /dev/dri /dev/input /dev/pts /dev/shm
node /dev/console c 5 1 0600
node /dev/null c 1 3 0666
node /dev/zero c 1 5 0666
node /dev/full c 1 7 0666
node /dev/random c 1 8 0666
node /dev/urandom c 1 9 0666
node /dev/tty c 5 0 0666
node /dev/tty0 c 4 0 0600
node /dev/tty1 c 4 1 0600
node /dev/ptmx c 5 2 0666
node /dev/block/mmcblk0 b 179 0 0600
node /dev/block/mmcblk0p9 b 179 9 0600
node /dev/graphics/fb0 c 29 0 0660
node /dev/dri/card0 c 226 0 0660
node /dev/dri/controlD64 c 226 64 0600
node /dev/input/event2 c 13 66 0660
$BB ln -sf /dev/graphics/fb0 /dev/fb0
$BB mount -t devpts devpts /dev/pts
$BB mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm

say "loading the factory display modules"
if ! $BB insmod /lib/modules/tngdisp.ko; then
    say "tngdisp did not load"
    exec $BB sh
fi
# dfrgx is useful to the PowerVR stack but is not required by fbdev Xorg.
$BB insmod /lib/modules/dfrgx.ko || say "warning: dfrgx did not load; continuing with psbfb"

say "mounting userdata partition mmcblk0p9"
if ! $BB mount -t ext4 -o rw,noatime /dev/block/mmcblk0p9 /data; then
    say "userdata mount failed"
    exec $BB sh
fi

if [ ! -x "$ROOT/usr/lib/xorg/Xorg" ] || [ ! -x "$ROOT/usr/bin/phoc" ]; then
    say "Debian root is missing or incomplete at $ROOT"
    exec $BB sh
fi

$BB mkdir -p "$ROOT/dev" "$ROOT/proc" "$ROOT/sys" "$ROOT/run" \
    "$ROOT/tmp/.X11-unix" "$ROOT/var/log"
$BB mount --bind /dev "$ROOT/dev"
$BB mount --bind /proc "$ROOT/proc"
$BB mount --bind /sys "$ROOT/sys"
$BB mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$ROOT/run"
$BB mkdir -p "$ROOT/run/user/0" "$ROOT/run/udev/data"
$BB chmod 0700 "$ROOT/run/user/0"
$BB chmod 1777 "$ROOT/tmp" "$ROOT/tmp/.X11-unix"

# libinput normally learns this from udev. There is intentionally no udevd in
# the first payload, so provide the one record proven on the physical phone.
cat >"$ROOT/run/udev/data/c13:66" <<'EOF'
I:1
E:ID_INPUT=1
E:ID_INPUT_TOUCHSCREEN=1
E:ID_PATH=p90-synaptics-touchscreen
V:1
EOF

$BB cp /etc/p90-xorg.conf "$ROOT/run/p90-xorg.conf"
$BB cp /etc/p90-session.sh "$ROOT/run/p90-session.sh"
$BB chmod 0755 "$ROOT/run/p90-session.sh"

say "entering Debian; Android userspace has not been started"
exec $BB chroot "$ROOT" /run/p90-session.sh
